#  LINEAR REGRESSION


features = [
    "Engine Size(L)",
    "Cylinders",
    "Fuel Consumption City (L/100 km)",
    "Fuel Consumption Hwy (L/100 km)",
    "Fuel Consumption Comb (L/100 km)"
]

X = df[features].values
y = df["CO2 Emissions(g/km)"].values

# Standardization
mean = np.mean(X, axis=0)
std = np.std(X, axis=0)

X = (X - mean) / std



np.random.seed(42)

index = np.random.permutation(len(X))

n = int(0.8 * len(X))

train = index[:n]
test = index[n:]

X_train = X[train]
X_test = X[test]

y_train = y[train]
y_test = y[test]



def Jcost(X, y, w, b):

    m = len(y)

    predictions = X @ w + b
    cost = (1 / (2 * m)) * np.sum(
        (predictions - y) ** 2
    )

    return cost

def gradient_descent(X, y, w, b, alpha, iterations):

    m = len(y)
    cost_history = []

    for i in range(iterations):

        predictions = X @ w + b

        dw = (1 / m) * X.T @ (predictions - y)
        db = (1 / m) * np.sum(predictions - y)
        w = w - alpha * dw
        b = b - alpha * db
        cost = Jcost(X, y, w, b)
        cost_history.append(cost)

    return w, b, cost_history



w = np.zeros(X_train.shape[1])
b = 0

#learnrate
alpha = 0.01
iterations = 10000



w, b, cost_history = gradient_descent(
    X_train,
    y_train,
    w,
    b,
    alpha,
    iterations
)


#pred
y_pred = X_test @ w + b
print ("w: ",w, "b: ",b,"")

#  MODEL EVALUATION


mae = np.mean(
    np.abs(y_test - y_pred)
)

rmse = np.sqrt(
    np.mean((y_test - y_pred) ** 2)
)

#r2 = 1 - (
 #   np.sum((y_test - y_pred) ** 2) /
 #   np.sum((y_test - np.mean(y_test)) ** 2)
#)


